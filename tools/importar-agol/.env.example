# Copia este archivo a ".env" y rellena los valores. El ".env" real NUNCA se sube al repo.

# --- ArcGIS Online (bidegi.maps.arcgis.com) ---
AGOL_ORG_URL=https://bidegi.maps.arcgis.com
# Opcion recomendada: API Key generada desde el portal (Organizacion > Configuracion > Claves de API).
# Si se rellena AGOL_API_KEY, se usa directamente y AGOL_USUARIO/AGOL_PASSWORD se ignoran.
AGOL_API_KEY=
# Alternativa (solo si el usuario/password funciona contra el endpoint generateToken de tu organizacion):
AGOL_USUARIO=
AGOL_PASSWORD=

# --- PostgreSQL/PostGIS ---
# El puerto 5432 del servidor ya es accesible directamente (confirmado con la conexion de QGIS
# "BIDELAN_Nube"), asi que no hace falta tunel SSH: PGHOST/PGPORT apuntan al servidor directamente.
# Si en tu caso 5432 no fuera accesible, usa un tunel SSH (ssh -L 5433:localhost:5432 <usuario>@217.71.202.62)
# y cambia PGHOST=localhost / PGPORT=5433.
# El rol indicado en PGUSER debe tener permisos CREATE y USAGE sobre el schema "public"
# (las tablas del proyecto, como pk_v0, viven en el schema "public" de la base "bidelan", no en uno
# llamado "bidelan" — ese es el nombre de la base de datos, no de un schema):
#   GRANT CREATE, USAGE ON SCHEMA public TO <rol>;
PGHOST=217.71.202.62
PGPORT=5432
PGDATABASE=bidelan
PGUSER=
PGPASSWORD=
PGSSLMODE=disable
PGSCHEMA=public

# --- Subida de adjuntos al servidor (SFTP) ---
SSH_HOST=217.71.202.62
SSH_PORT=22
SSH_USUARIO=
# Usa SSH_KEY_PATH si te conectas con clave (recomendado) o SSH_PASSWORD si usas contraseña.
SSH_KEY_PATH=
SSH_PASSWORD=
# Carpeta remota donde se guardan los adjuntos, y su ruta relativa a /opt/bidelan
# (la misma que ya usa el proyecto para datos/ — ver CLAUDE.md).
ADJUNTOS_DIR_REMOTO=/opt/bidelan/datos/adjuntos
ADJUNTOS_RUTA_RELATIVA=datos/adjuntos
