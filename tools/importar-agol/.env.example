# Copia este archivo a ".env" y rellena los valores. El ".env" real NUNCA se sube al repo.

# --- ArcGIS Online (bidegi.maps.arcgis.com) ---
AGOL_ORG_URL=https://bidegi.maps.arcgis.com
# Opcion recomendada: API Key generada desde el portal (Organizacion > Configuracion > Claves de API).
# Si se rellena AGOL_API_KEY, se usa directamente y AGOL_USUARIO/AGOL_PASSWORD se ignoran.
AGOL_API_KEY=
# Alternativa (solo si el usuario/password funciona contra el endpoint generateToken de tu organizacion):
AGOL_USUARIO=
AGOL_PASSWORD=

# --- PostgreSQL/PostGIS ---
# El puerto 5432 ahora esta restringido por IP en el firewall del servidor (ya no es accesible
# directo desde cualquier sitio). Si tu IP actual no esta en la lista blanca, usa un tunel SSH:
#   ssh -L 15432:localhost:5432 <usuario>@217.71.202.62
# y cambia PGHOST=localhost / PGPORT=15432 (dejalo abierto mientras uses la herramienta).
# El servidor tambien exige conexion cifrada: PGSSLMODE=require (no "disable").
# El rol indicado en PGUSER debe tener permisos CREATE y USAGE sobre el schema "public"
# (las tablas del proyecto, como pk_v0, viven en el schema "public" de la base "bidelan", no en uno
# llamado "bidelan" — ese es el nombre de la base de datos, no de un schema):
#   GRANT CREATE, USAGE ON SCHEMA public TO <rol>;
PGHOST=217.71.202.62
PGPORT=5432
PGDATABASE=bidelan
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PGSCHEMA=public

# --- Subida de adjuntos al servidor (SFTP) ---
SSH_HOST=217.71.202.62
SSH_PORT=22
SSH_USUARIO=
# Usa SSH_KEY_PATH (recomendado, y probablemente obligatorio si el servidor ya no acepta
# autenticacion por contrasena) o SSH_PASSWORD como alternativa.
# Si tu clave privada tiene passphrase, ponla en SSH_KEY_PASSPHRASE — es local, el servidor
# nunca la ve; no confundir con una contrasena de servidor.
SSH_KEY_PATH=
SSH_KEY_PASSPHRASE=
SSH_PASSWORD=
# Carpeta remota donde se guardan los adjuntos, y su ruta relativa a /opt/bidelan
# (la misma que ya usa el proyecto para datos/ — ver CLAUDE.md).
ADJUNTOS_DIR_REMOTO=/opt/bidelan/datos/adjuntos
ADJUNTOS_RUTA_RELATIVA=datos/adjuntos

# --- Publicar automaticamente en GeoServer (opcional) ---
# Si rellenas esto, al terminar de importar la tabla el script la publica
# como capa nueva en GeoServer via su API REST (equivalente a "Add a new
# layer > Publish" en la interfaz web, con el bounding box calculado solo).
# Deja estas variables vacias para seguir dejando la publicacion manual.
# GEOSERVER_USUARIO/PASSWORD son las credenciales de ADMINISTRADOR de
# GeoServer — nunca las de por defecto (admin/geoserver); si siguen siendo
# las de fabrica, cambialas antes de rellenar esto.
GEOSERVER_URL=https://visor.geospatiallab.xyz/geoserver
GEOSERVER_WORKSPACE=bidelan
# Nombre del almacen (datastore) PostGIS que ya publica pk_v0/partes_accidentes
# — compruebalo en GeoServer: Stores, dentro del workspace "bidelan".
GEOSERVER_DATASTORE=
GEOSERVER_USUARIO=
GEOSERVER_PASSWORD=
