# Copia este archivo a ".env" y rellena los valores. El ".env" real NUNCA se sube al repo.

# --- ArcGIS Online (bidegi.maps.arcgis.com) ---
AGOL_ORG_URL=https://bidegi.maps.arcgis.com
AGOL_USUARIO=
AGOL_PASSWORD=

# --- PostgreSQL/PostGIS ---
# Se asume que llegas al servidor via tunel SSH:
#   ssh -L 5433:localhost:5432 <usuario>@217.71.202.62
# y por eso PGHOST/PGPORT apuntan al extremo local del tunel, no al servidor directamente.
# El rol indicado en PGUSER debe tener permisos CREATE y USAGE sobre el schema "bidelan":
#   GRANT CREATE, USAGE ON SCHEMA bidelan TO <rol>;
PGHOST=localhost
PGPORT=5433
PGDATABASE=bidelan
PGUSER=
PGPASSWORD=
PGSSLMODE=disable
PGSCHEMA=bidelan

# --- Subida de adjuntos al servidor (SFTP) ---
SSH_HOST=217.71.202.62
SSH_PORT=22
SSH_USUARIO=
# Usa SSH_KEY_PATH si te conectas con clave (recomendado) o SSH_PASSWORD si usas contraseña.
SSH_KEY_PATH=
SSH_PASSWORD=
# Carpeta remota donde se guardan los adjuntos, y su ruta relativa a /opt/bidelan
# (la misma que ya usa el proyecto para datos/ — ver CLAUDE.md).
ADJUNTOS_DIR_REMOTO=/opt/bidelan/datos/adjuntos
ADJUNTOS_RUTA_RELATIVA=datos/adjuntos
