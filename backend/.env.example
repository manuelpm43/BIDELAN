# Copia este archivo a ".env" y rellena los valores reales.
# ".env" nunca debe subirse al repositorio (ver .gitignore).

# Puerto donde escucha este backend
PORT=4000

# Orígenes (URLs) desde los que se sirve el visor BIDELAN, para permitir CORS.
# Admite varios separados por comas (localhost y 127.0.0.1 cuentan como orígenes distintos).
ORIGEN_PERMITIDO=http://localhost:5500,http://127.0.0.1:5500

# Conexión a la misma PostgreSQL que usa GeoServer
PGHOST=217.71.202.62
PGPORT=5432
PGDATABASE=bidelan
PGUSER=bidelan_auth
PGPASSWORD=

# Secreto para firmar los JWT. Genera uno propio, largo y aleatorio
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRETO=cambia-este-valor-por-uno-largo-y-aleatorio
JWT_EXPIRA_EN=7d
